# ==============================================================================
# ASHNORA ENVIRONMENT CONFIGURATION & CODE SIGNING SECRETS TEMPLATE
# ==============================================================================
# IMPORTANT:
# NEVER commit the actual .env, .pfx, or password files to version control.
# Copy this file to .env.local for local overrides or configure in GitHub Secrets.
# ==============================================================================

# Supabase Realtime & Remote Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Windows Authenticode Code Signing Credentials
# ------------------------------------------------------------------------------
# WIN_CSC_LINK:
# Can be an absolute local filesystem path:
#   WIN_CSC_LINK="C:\\Users\\User\\certs\\Ashnora_CodeSigning.pfx"
# OR in CI/CD (GitHub Actions), a base64-encoded string of the .pfx file:
#   (run `[Convert]::ToBase64String([IO.File]::ReadAllBytes('cert.pfx'))` in PowerShell)
#
# WIN_CSC_KEY_PASSWORD:
# The private key password used to protect the .pfx certificate.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Build Behavior
# ------------------------------------------------------------------------------
# Set to 'true' in CI/CD release workflows to enforce that all binaries MUST
# be validly signed by SignTool; fails the build if credentials are missing.
FORCE_SIGN=false

# Optional Cloud Signing (Azure Trusted Signing / DigiCert KeyLocker)
# ------------------------------------------------------------------------------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_CODE_SIGNING_ACCOUNT_NAME=
# AZURE_CERTIFICATE_PROFILE_NAME=
